# Copiar a .github/workflows/publicar.yml en el repositorio de un cliente real.
# Cada vez que el panel guarda, GitHub Actions arma el sitio y lo publica en Cloudflare Pages.
# Secreto necesario: CLOUDFLARE_API_TOKEN (permiso "Cloudflare Pages: Edit"). Nunca va en el código.
name: Publicar sitio
on:
  push:
    branches: [main]
  workflow_dispatch:
jobs:
  publicar:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with: { python-version: "3.12" }
      - run: pip install -r requirements.txt
      - run: python3 panel/construir.py
      - uses: actions/setup-node@v4
        with: { node-version: "22" }
      - run: npx --yes wrangler@4 pages deploy salida/panaderia-la-esquina --project-name NOMBRE-DEL-PROYECTO --branch main
        env:
          CLOUDFLARE_API_TOKEN: ${{ secrets.CLOUDFLARE_API_TOKEN }}
          CLOUDFLARE_ACCOUNT_ID: ID-DE-LA-CUENTA
